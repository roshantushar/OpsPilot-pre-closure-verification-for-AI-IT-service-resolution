# ---------------------------------------------------------------------------
# OpsPilot — environment template
# Copy to .env and fill in your key:   cp .env.example .env
# .env must be listed in .gitignore. Never commit or print your real key.
# ---------------------------------------------------------------------------

# --- Provider (OpenRouter, OpenAI-compatible API) --------------------------
OPENROUTER_API_KEY=sk-or-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers OpenRouter accepts
OPENROUTER_HTTP_REFERER=https://github.com/<your-username>/OpsPilot
OPENROUTER_APP_TITLE=OpsPilot-PE6201

# --- Backend ----------------------------------------------------------------
# scripted = no API calls ($0) · openrouter = live model
BACKEND=scripted

# --- Models (pin exact strings; record the date you pinned them) ------------
# Primary model; switch to openai/gpt-4o-mini if the cost probe shows > $0.009/case
OPSPILOT_MODEL=openai/gpt-5-mini
FALLBACK_MODEL=openai/gpt-4o-mini
# A free OpenRouter model for development/debugging (pick one and pin it; free models are rate-limited)
DEV_FREE_MODEL=REPLACE_WITH_PINNED_FREE_MODEL_ID
# D5 model battery (verify availability and price; pin exact strings)
BATTERY_MODELS=openai/gpt-4o-mini,google/gemini-2.5-flash-lite,REPLACE_WITH_PINNED_FREE_MODEL_ID
# L2 evidence judge: must differ from the model being judged
JUDGE_MODEL=google/gemini-2.5-flash-lite
MODEL_PINNED_ON=2026-09-22

# --- Generation settings ----------------------------------------------------
# gpt-5 family bills reasoning tokens as output; keep effort low unless testing it (L1)
REASONING_EFFORT=low
# Some reasoning models ignore temperature; the code logs what was actually accepted
TEMPERATURE=0
MAX_OUTPUT_TOKENS=800
REQUEST_TIMEOUT_S=60
MAX_RETRIES=3

# --- Prices used only when the API does not report cost (USD per 1M tokens; verify current) ---
PRICE_INPUT_PER_M=0.25
PRICE_OUTPUT_PER_M=2.00
PRICE_CACHED_INPUT_PER_M=0.025

# --- Budget guards ----------------------------------------------------------
MAX_BUDGET_USD=3.50
DEFAULT_EXPERIMENT_CAP_USD=0.30
MAX_COST_PER_CASE_USD=0.03
# Ring-fenced for D8 / D8-b (EXPERIMENTS_FOR_CLAUDE_CODE.md F4): non-D8 calls are refused once
# spending them would leave less than this much of MAX_BUDGET_USD.
RESERVED_FOR_D8_USD=0.62
# Ask for confirmation when a batch projection exceeds its cap
REQUIRE_CONFIRM_ABOVE_CAP=true

# --- Agent guardrails (defaults; manifests can override) --------------------
STEP_CAP=8
MAX_TOOL_OUTPUT_CHARS=4000
DEDUP_TOOL_CALLS=true
COMPACT_TOOLS=true

# --- Paths --------------------------------------------------------------------
DATA_DIR=data/opspilot_itsm_data
SUBSETS_DIR=data/subsets
RESULTS_DIR=results
CACHE_DIR=.cache/llm

# --- Reproducibility ---------------------------------------------------------
RANDOM_SEED=42
DATASET_VERSION=synthetic-v1

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
SAVE_TRACES=true
